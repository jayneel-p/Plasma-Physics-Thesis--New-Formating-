\@writefile{toc}{\contentsline {section}{\numberline {2}Experimental Setup}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Synthetic Data: Coupled Van der Pol Oscillators}{3}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Time series of the Ding coupled oscillator system ($a_1=a_2=1$, $a=0.5$, $b=-2.5$). The pronounced cycle-to-cycle modulation reflects quasi-periodic dynamics with strong nonlinear coupling.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:ding_ts}{{1}{3}{Time series of the Ding coupled oscillator system ($a_1=a_2=1$, $a=0.5$, $b=-2.5$). The pronounced cycle-to-cycle modulation reflects quasi-periodic dynamics with strong nonlinear coupling}{figure.1}{}}
\abx@aux@cite{0}{dingNonlinearRadialCorrelation1997}
\abx@aux@segm{0}{0}{dingNonlinearRadialCorrelation1997}
\abx@aux@cite{0}{bsharatConditionalCrosscorrelationAnalysis2024}
\abx@aux@segm{0}{0}{bsharatConditionalCrosscorrelationAnalysis2024}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Phase-space projections of the Ding system. The thickened, multi-loop structure indicates a quasi-periodic attractor with amplitude modulation, in contrast to the thin closed orbit of a simple Van der Pol limit cycle.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:ding_phase}{{2}{4}{Phase-space projections of the Ding system. The thickened, multi-loop structure indicates a quasi-periodic attractor with amplitude modulation, in contrast to the thin closed orbit of a simple Van der Pol limit cycle}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Time series of the van Milligen (2014) oscillator pair ($a_1 = 1$, $a_2 = 1.1$, unidirectional coupling $x_2 \rightarrow x_1$). The dynamics are nearly periodic, with only slight modulation arising from detuning.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:vm_ts}{{3}{4}{Time series of the van Milligen (2014) oscillator pair ($a_1 = 1$, $a_2 = 1.1$, unidirectional coupling $x_2 \rightarrow x_1$). The dynamics are nearly periodic, with only slight modulation arising from detuning}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Phase-space projections of the van Milligen system. Each oscillator approaches a thin quasi-periodic torus resembling a limit cycle, and the $(x_1,x_2)$ projection clearly shows unidirectional driving from oscillator~2 to oscillator~1.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:vm_phase}{{4}{4}{Phase-space projections of the van Milligen system. Each oscillator approaches a thin quasi-periodic torus resembling a limit cycle, and the $(x_1,x_2)$ projection clearly shows unidirectional driving from oscillator~2 to oscillator~1}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Experimental Data: Floating-Potential Fluctuations}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces HT-7 floating-potential time series from probes at $r_1$ and $r_2$ over the first $50\,\mathrm  {ms}$ of the discharge. The signal transitions from a quiescent phase to an intermittent burst and finally to broadband turbulent fluctuations.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:ht7_overview_ts}{{5}{6}{HT-7 floating-potential time series from probes at $r_1$ and $r_2$ over the first $50\,\mathrm {ms}$ of the discharge. The signal transitions from a quiescent phase to an intermittent burst and finally to broadband turbulent fluctuations}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Time series of $(x(t), y(t))$ over the first NLCC analysis window (e.g.\ $100$--$105\,\mathrm  {ms}$). The fluctuations are approximately stationary over this short interval, in contrast to the global evolution shown in Fig.~\ref {fig:ht7_overview_ts}.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:ht7_window_ts}{{6}{6}{Time series of $(x(t), y(t))$ over the first NLCC analysis window (e.g.\ $100$--$105\,\mathrm {ms}$). The fluctuations are approximately stationary over this short interval, in contrast to the global evolution shown in Fig.~\ref {fig:ht7_overview_ts}}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Two-dimensional delay embedding $(x(t), x(t+\tau ))$ of the HT-7 floating-potential signal using the same delay $\tau $ as in the NLCC analysis. The cloud-like occupation of the plane reflects broadband, weakly correlated turbulent dynamics, in contrast to the thin closed curves produced by synthetic oscillator models.}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:ht7_embed}{{7}{6}{Two-dimensional delay embedding $(x(t), x(t+\tau ))$ of the HT-7 floating-potential signal using the same delay $\tau $ as in the NLCC analysis. The cloud-like occupation of the plane reflects broadband, weakly correlated turbulent dynamics, in contrast to the thin closed curves produced by synthetic oscillator models}{figure.7}{}}
