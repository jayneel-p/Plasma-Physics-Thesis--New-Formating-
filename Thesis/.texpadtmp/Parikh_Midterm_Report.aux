\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Phase-space projections of the Ding system. The thickened, multi-loop structure indicates a quasi-periodic attractor with amplitude modulation, in contrast to the thin closed orbit of a simple Van der Pol limit cycle.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ding_phase}{{2}{4}{Phase-space projections of the Ding system. The thickened, multi-loop structure indicates a quasi-periodic attractor with amplitude modulation, in contrast to the thin closed orbit of a simple Van der Pol limit cycle}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Time series of the van Milligen (2014) oscillator pair ($a_1 = 1$, $a_2 = 1.1$, unidirectional coupling $x_2 \rightarrow x_1$). The dynamics are nearly periodic, with only slight modulation arising from detuning.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:vm_ts}{{3}{4}{Time series of the van Milligen (2014) oscillator pair ($a_1 = 1$, $a_2 = 1.1$, unidirectional coupling $x_2 \rightarrow x_1$). The dynamics are nearly periodic, with only slight modulation arising from detuning}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Phase-space projections of the van Milligen system. Each oscillator approaches a thin quasi-periodic torus resembling a limit cycle, and the $(x_1,x_2)$ projection clearly shows unidirectional driving from oscillator~2 to oscillator~1.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:vm_phase}{{4}{4}{Phase-space projections of the van Milligen system. Each oscillator approaches a thin quasi-periodic torus resembling a limit cycle, and the $(x_1,x_2)$ projection clearly shows unidirectional driving from oscillator~2 to oscillator~1}{figure.caption.7}{}}
