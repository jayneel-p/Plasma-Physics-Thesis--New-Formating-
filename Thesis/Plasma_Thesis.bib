@article{vanmilligenCausalityDetectionTurbulence2013,
  title = {Causality Detection and Turbulence in Fusion Plasmas},
  author = {family=Milligen, given=B. Ph., given-i=B{{Ph}}, prefix=van, useprefix=true and Birkenmeier, G. and Ramisch, M. and Estrada, T. and Hidalgo, C. and Alonso, A.},
  date = {2013},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.1309.7769},
  url = {https://arxiv.org/abs/1309.7769},
  urldate = {2025-11-09},
  abstract = {This work explores the potential of an information-theoretical causality detection method for unraveling the relation between fluctuating variables in complex nonlinear systems. The method is tested on some simple though nonlinear models, and guidelines for the choice of analysis parameters are established. Then, measurements from magnetically confined fusion plasmas are analyzed. The selected data bear relevance to the all-important spontaneous confinement transitions often observed in fusion plasmas, fundamental for the design of an economically attractive fusion reactor. It is shown how the present method is capable of clarifying the interaction between fluctuating quantities such as the turbulence amplitude, turbulent flux, and Zonal Flow amplitude, and uncovers several interactions that were missed by traditional methods.},
  version = {3},
  keywords = {FOS: Physical sciences,Plasma Physics (physics.plasm-ph)}
}

@article{vanmilligenRadialPropagationHeat2019,
  title = {The {{Radial Propagation}} of {{Heat}} in {{Strongly Driven Non-Equilibrium Fusion Plasmas}}},
  author = {Van Milligen, Boudewijn and Carreras, Benjamin and García, Luis and Nicolau, Javier},
  date = {2019-02-05},
  journaltitle = {Entropy},
  shortjournal = {Entropy},
  volume = {21},
  number = {2},
  pages = {148},
  issn = {1099-4300},
  doi = {10.3390/e21020148},
  url = {https://www.mdpi.com/1099-4300/21/2/148},
  urldate = {2025-11-09},
  abstract = {Heat transport is studied in strongly heated fusion plasmas, far from thermodynamic equilibrium. The radial propagation of perturbations is studied using a technique based on the transfer entropy. Three different magnetic confinement devices are studied, and similar results are obtained. “Minor transport barriers” are detected that tend to form near rational magnetic surfaces, thought to be associated with zonal flows. Occasionally, heat transport “jumps” over these barriers, and this “jumping” behavior seems to increase in intensity when the heating power is raised, suggesting an explanation for the ubiquitous phenomenon of “power degradation” observed in magnetically confined plasmas. Reinterpreting the analysis results in terms of a continuous time random walk, “fast” and “slow” transport channels can be discerned. The cited results can partially be understood in the framework of a resistive Magneto-HydroDynamic model. The picture that emerges shows that plasma self-organization and competing transport mechanisms are essential ingredients for a fuller understanding of heat transport in fusion plasmas.},
  langid = {english},
  file = {/Users/jayneelparikh/Zotero/storage/JV3HBQ46/Van Milligen et al. - 2019 - The Radial Propagation of Heat in Strongly Driven Non-Equilibrium Fusion Plasmas.pdf}
}

@online{gutmanTakensEmbeddingTheorem2015,
  title = {Takens' Embedding Theorem with a Continuous Observable},
  author = {Gutman, Yonatan},
  date = {2015},
  doi = {10.48550/ARXIV.1510.05843},
  url = {https://arxiv.org/abs/1510.05843},
  urldate = {2025-11-12},
  abstract = {Let \$(X,T)\$ be a dynamical system where \$X\$ is a compact metric space and \$T:X\textbackslash rightarrow X\$ is continuous and invertible. Assume the Lebesgue covering dimension of \$X\$ is \$d\$. We show that for a generic continuous map \$h:X\textbackslash rightarrow[0,1]\$, the \$(2d+1)\$-delay observation map \$x\textbackslash mapsto\textbackslash big(h(x),h(Tx),\textbackslash ldots,h(T\textasciicircum\{2d\}x)\textbackslash big)\$ is an embedding of \$X\$ inside \$[0,1]\textasciicircum\{2d+1\}\$. This is a generalization of the discrete version of the celebrated Takens embedding theorem, as proven by Sauer, Yorke and Casdagli to the setting of a continuous observable. In particular there is no assumption on the (lower) box-counting dimension of \$X\$ which may be infinite.},
  pubstate = {prepublished},
  version = {2},
  keywords = {37C45 54H20,Dynamical Systems (math.DS),FOS: Mathematics,FOS: Physical sciences,Mathematical Physics (math-ph)}
}

